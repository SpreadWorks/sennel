              "findingKey": "ledger-json-parse-errors-misclassified",
              "title": "Malformed Activity ledger JSON is classified as integrity failure",
              "failureMode": "spec_behavior_contradiction",
              "file": "src/flow/query.js",
              "requirementId": "R13",
              "issue": "readConfirmedLedger() catches JSON.parse(line) failures together with schema and contiguous-order failures and always emits CANONICAL_RECORD_INCONSISTENT. A malformed ledger line is a canonical parse failure and must use CANONICAL_RECORD_UNREADABLE.",
              "suggestion": "Separate JSON decoding from FlowActivity validation in readConfirmedLedger(): classify JSON.parse failures as CANONICAL_RECORD_UNREADABLE and retain CANONICAL_RECORD_INCONSISTENT for Activity schema, duplicate-ID, and confirmation-order violations.",
              "disposition": "must-fix",
              "rationale": "R13 explicitly separates parse/read failures from ledger integrity failures, so the broad catch produces the wrong externally observable error classification.",
