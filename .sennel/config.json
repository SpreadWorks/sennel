{
  "name": "senti",
  "logs": {
    "enabled": true
  },
  "lang": "ja",
  "type": [
    "node-cli",
    "greenfield",
    "document"
  ],
  "concurrency": 4,
  "docs": {
    "languages": [
      "ja",
      "en"
    ],
    "defaultLanguage": "en",
    "mode": "generate",
    "exclude": [
      "experimental/**",
      "src/presets/**"
    ],
    "style": {
      "purpose": "user-guide",
      "tone": "polite",
      "customInstruction": ""
    }
  },
  "chapters": [
    {
      "chapter": "overview.md",
      "desc": "senti の目的・設計思想・主要機能の概要"
    },
    {
      "chapter": "stack_and_ops.md",
      "desc": "Node.js ランタイム、外部依存なしポリシー、動作要件"
    },
    {
      "chapter": "project_structure.md",
      "desc": "src/ のディレクトリ構造、3層ディスパッチ、プリセットシステム"
    },
    {
      "chapter": "cli_commands.md",
      "desc": "docs/spec/flow サブコマンド群、オプション、使用例、終了コード"
    },
    {
      "chapter": "configuration.md",
      "desc": "config.json スキーマ、agent 設定、プリセット設定、flow 設定"
    },
    {
      "chapter": "internal_design.md",
      "desc": "テンプレートエンジン、DataSource、enrich パイプライン、言語ハンドラ"
    },
    {
      "chapter": "creating_presets.md",
      "desc": "プリセット作成ガイド。preset.json スキーマ、DataSource 実装、テンプレート継承、scan/data ペアリング規則、AI 向け実行チェックリスト"
    },
    {
      "chapter": "development_testing.md",
      "exclude": true
    }
  ],
  "scan": {
    "include": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.cjs",
      "package.json"
    ],
    "exclude": [
      "experimental/**"
    ]
  },
  "flow": {
    "merge": "squash"
  },
  "commands": {
    "gh": "enable"
  },
  "test": {
    "command": "node tests/run.js",
    "projectPaths": [
      "tests/unit/"
    ],
    "testExecuteRegression": "targeted",
    "finalRegressionTimeout": 1200
  },
  "agent": {
    "default": "codex",
    "workDir": ".tmp",
    "retryCount": 2,
    "useProfile": "codex-only",
    "promptCharacterLimit": 60000
  },
  "plugin": {
    "packages": [
      {
        "id": "official-presets",
        "commit": "31bdd70fecfcde33c32bd75909218b744561c24e",
        "source": "official-presets"
      },
      {
        "id": "workflow",
        "source": "sennel-workflow-plugin",
        "commit": "000cf6020b7ac83e93af4755a05c87f3e0f1496e"
      }
    ],
    "config": {
      "workflow": {
        "flowIntegration": "enable",
        "board": {
          "owner": "SpreadWorks",
          "projectNumber": 3
        },
        "agent": {
          "publish": {
            "provider": "codex/gpt-5.6-terra-low"
          },
          "classify": {
            "provider": "codex/gpt-5.6-luna-low"
          },
          "similarity": {
            "provider": "codex/gpt-5.6-luna-low"
          },
          "compose": {
            "provider": "codex/gpt-5.6-terra-medium"
          }
        },
        "languages": {
          "source": "ja",
          "publish": "en"
        }
      }
    },
    "sources": [
      {
        "id": "official-presets",
        "type": "git",
        "url": "git@github.com:SpreadWorks/sennel-presets.git"
      },
      {
        "id": "sennel-workflow-plugin",
        "type": "git",
        "url": "git@github.com:SpreadWorks/sennel-workflow-plugin.git"
      }
    ]
  }
}
