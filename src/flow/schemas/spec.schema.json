{
  "type": "object",
  "required": [
    "goal",
    "scope",
    "constraints",
    "design_principles",
    "overview",
    "background",
    "requirements",
    "acceptance_criteria",
    "clarifications",
    "alternatives_considered",
    "open_questions",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "goal": { "type": "string" },
    "background": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "additionalProperties": false,
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "design_principles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "overview": {
      "type": "object",
      "required": ["modules", "data_flow", "decisions"],
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 500 },
              "added_by_task": { "type": "string", "maxLength": 100 }
            }
          }
        },
        "data_flow": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 500 },
              "added_by_task": { "type": "string", "maxLength": 100 }
            }
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 500 },
              "evidence": { "type": "string", "maxLength": 1000 },
              "consideredAlternatives": { "type": "string", "maxLength": 1000 },
              "added_by_task": { "type": "string", "maxLength": 100 }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "desc", "task_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$" },
          "desc": { "type": "string", "maxLength": 119999 },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
            }
          },
          "priority": { "type": "string", "enum": ["must", "should", "nice-to-have"] },
          "testable": { "type": "boolean" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "additionalProperties": false,
        "properties": {
          "q": { "type": "string" },
          "a": { "type": "string" }
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "reason"],
        "additionalProperties": false,
        "properties": {
          "option": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "implementationTargets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "user_approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "boolean" },
        "confirmed_at": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "origin", "added_round", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "acceptance": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "implementation_notes": { "type": "string", "maxLength": 5000 },
          "test_strategy": { "type": "string", "maxLength": 2000 },
          "parent": { "type": ["string", "null"], "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$" },
          "origin": { "type": "string", "enum": ["plan"] },
          "added_round": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["pending", "in_progress", "done", "skipped"] }
        }
      }
    }
  }
}
