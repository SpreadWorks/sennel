{
  "type": "object",
  "required": ["sealed", "handoffPath", "handoffDigest", "payloadCount"],
  "properties": {
    "sealed": { "const": true },
    "handoffPath": { "type": "string" },
    "handoffDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payloadCount": { "type": "integer", "minimum": 0 },
    "acceptanceTruncationLog": { "type": "string" },
    "runtimeLog": {
      "type": "object",
      "required": ["runId", "sequence"],
      "properties": {
        "runId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
