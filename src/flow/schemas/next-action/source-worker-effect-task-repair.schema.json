{
  "type": "object",
  "required": ["version", "stepId", "completionStatus", "issues", "overview", "triage", "repair", "noChangeReason"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "stepId": { "type": "string", "enum": ["task-repair"] },
    "completionStatus": { "type": "string", "enum": ["done"] },
    "issues": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["classification", "reason", "remainingRisk"], "properties": { "classification": { "type": "string", "enum": ["quality"] }, "reason": { "type": "string", "minLength": 20 }, "remainingRisk": { "type": "string", "minLength": 20 } }, "additionalProperties": false } },
    "overview": { "type": "null" },
    "triage": { "type": "null" },
    "repair": {
      "type": ["object", "null"],
      "required": ["version", "findings", "summary", "recurrenceResolutions"],
      "properties": {
        "version": { "type": "integer", "enum": [1] },
        "findings": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "required": ["findingKey", "paths"], "properties": { "findingKey": { "type": "string", "minLength": 1 }, "paths": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
        "summary": { "type": "string", "minLength": 10 },
        "recurrenceResolutions": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["findingKey", "fingerprint", "priorRepairInsufficiency", "repairStrategy"], "properties": { "findingKey": { "type": "string", "minLength": 1 }, "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "priorRepairInsufficiency": { "type": "string", "minLength": 1 }, "repairStrategy": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "noChangeReason": {
      "type": ["object", "null"],
      "required": ["classification", "findingKeys", "reason"],
      "properties": {
        "classification": { "type": "string", "enum": ["no-change", "unrepairable"] },
        "findingKeys": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
