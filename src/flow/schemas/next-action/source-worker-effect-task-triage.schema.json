{
  "type": "object",
  "required": ["version", "stepId", "completionStatus", "issues", "overview", "triage", "repair", "noChangeReason"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "stepId": { "type": "string", "enum": ["task-triage"] },
    "completionStatus": { "type": "string", "enum": ["done"] },
    "issues": { "type": "array", "maxItems": 0, "items": { "type": "object", "required": ["classification", "reason", "remainingRisk"], "properties": { "classification": { "type": "string", "enum": ["quality"] }, "reason": { "type": "string", "minLength": 20 }, "remainingRisk": { "type": "string", "minLength": 20 } }, "additionalProperties": false } },
    "overview": { "type": "null" },
    "triage": { "type": "object", "required": ["version", "dispositions"], "properties": { "version": { "type": "integer", "enum": [1] }, "dispositions": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["findingKey", "disposition", "basis", "rationale"], "properties": { "findingKey": { "type": "string", "minLength": 1 }, "disposition": { "type": "string", "enum": ["apply", "reject"] }, "basis": { "type": "string", "enum": ["repair-required", "not-applicable", "already-satisfied", "finding-invalid", "approved-exception"] }, "rationale": { "type": "string", "minLength": 20 } }, "additionalProperties": false } } }, "additionalProperties": false },
    "repair": { "type": "null" },
    "noChangeReason": { "type": "null" }
  },
  "additionalProperties": false
}
