{
  "type": "object",
  "required": ["version", "stepId", "completionStatus", "issues", "overview", "triage", "repair", "noChangeReason"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "stepId": { "type": "string", "enum": ["task-impl"] },
    "completionStatus": { "type": "string", "enum": ["done"] },
    "issues": { "type": "array", "maxItems": 256, "items": { "type": "object", "required": ["classification", "reason", "remainingRisk"], "properties": { "classification": { "type": "string", "enum": ["quality"] }, "reason": { "type": "string", "minLength": 20 }, "remainingRisk": { "type": "string", "minLength": 20 } }, "additionalProperties": false } },
    "overview": { "type": "object", "required": ["modules", "data_flow", "decisions"], "properties": { "modules": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }, "data_flow": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }, "decisions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } } }, "additionalProperties": false },
    "triage": { "type": "null" },
    "repair": { "type": "null" },
    "noChangeReason": { "type": ["string", "null"], "minLength": 1 }
  },
  "additionalProperties": false
}
