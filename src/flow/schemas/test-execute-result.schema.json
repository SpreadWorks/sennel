{
  "type": "object",
  "required": ["version", "repairFingerprint", "testSourceRevision", "rawEvidenceFingerprint", "process", "raw_output_path", "summary", "regression"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "enum": ["2"] },
    "repairFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "testSourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawEvidenceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "process": {
      "type": "object",
      "required": ["started", "exitCode", "signal", "timedOut", "spawnError"],
      "additionalProperties": false,
      "properties": {
        "started": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"], "minimum": 0 },
        "signal": { "type": ["string", "null"], "minLength": 1 },
        "timedOut": { "type": "boolean" },
        "spawnError": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "raw_output_path": { "type": "string" },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail", "deferred", "not_applicable"] },
          "reason": { "type": "string", "enum": ["no_tests_declared"] },
          "deferred_receipt": {
            "type": "object",
            "required": ["requirementId", "specRevision", "bundleRevision", "candidateDigest", "expectation", "budget", "sourceAttempt", "sourceArtifact", "sourceFindingFingerprints"],
            "additionalProperties": false,
            "properties": {
              "requirementId": { "type": "string" },
              "specRevision": { "type": "object" },
              "bundleRevision": { "type": ["integer", "null"] },
              "candidateDigest": { "type": ["string", "null"] },
              "expectation": { "type": "string", "enum": ["fail", "pass"] },
              "budget": { "type": "object" },
              "sourceAttempt": { "type": "object" },
              "sourceArtifact": { "type": "string" },
              "sourceFindingFingerprints": { "type": "array", "items": { "type": "string" } }
            }
          },
          "error": { "type": "string" },
          "evidence": {
            "type": "object",
            "required": ["command", "raw_output_lines"],
            "additionalProperties": false,
            "properties": {
              "test_file": { "type": "string" },
              "test_name": { "type": "string" },
              "command": { "type": "string" },
              "raw_output_lines": {
                "type": "object",
                "required": ["start_line", "end_line"],
                "additionalProperties": false,
                "properties": {
                  "start_line": { "type": "integer", "minimum": 1 },
                  "end_line": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "regression": {
      "type": "object",
      "required": ["required", "result", "mode", "changed_files", "trigger_relevant_changed_files"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "mode": { "type": "string", "enum": ["full", "targeted", "none"] },
        "root_test_command": { "type": "string" },
        "root_test_command_source": { "type": "string" },
        "command": { "type": "string" },
        "target_paths": { "type": "array", "items": { "type": "string" } },
        "raw_output_lines": {
          "type": "object",
          "required": ["start_line", "end_line"],
          "additionalProperties": false,
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 }
          }
        },
        "process": {
          "type": "object",
          "required": ["started", "exitCode", "signal", "timedOut", "spawnError"],
          "additionalProperties": false,
          "properties": {
            "started": { "type": "boolean" },
            "exitCode": { "type": ["integer", "null"], "minimum": 0 },
            "signal": { "type": ["string", "null"], "minLength": 1 },
            "timedOut": { "type": "boolean" },
            "spawnError": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path", "fingerprint"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "string" },
              "path": { "type": "string" },
              "old_path": { "type": "string" },
              "fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "trigger_relevant_changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path", "fingerprint"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "string" },
              "path": { "type": "string" },
              "old_path": { "type": "string" },
              "fingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "docs-only",
            "spec-artifact-only",
            "non-project-only",
            "mixed-non-trigger",
            "full-regression-deferred",
            "project-regression-skipped"
          ]
        },
        "reason": { "type": "string" },
        "classified_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "category"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "docs-only",
                  "spec-artifact-only",
                  "non-project-only",
                  "mixed-non-trigger",
                  "full-regression-deferred",
                  "project-regression-skipped"
                ]
              }
            }
          }
        }
      }
    }
  }
}
